{
  "name": "@occubuy/score-sdk",
  "version": "0.1.0",
  "description": "Occubuy Partner Score SDK — embeddable renter score verification widget",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/occubuy-sdk.iife.global.js",
  "files": ["dist"],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "size": "size-limit",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["occubuy", "sdk", "embeddable", "score"],
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@size-limit/preset-small-lib": "^11.1.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.0",
    "prettier": "^3.3.3",
    "size-limit": "^11.1.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "size-limit": [
    {
      "path": "dist/occubuy-sdk.iife.global.js",
      "limit": "10 KB"
    }
  ]
}

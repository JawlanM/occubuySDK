# Copy this to .env (db-proxy/.env) and fill in real values. Never commit the real .env.

# Standard MongoDB Atlas connection string (mongodb+srv://...), the same one you'd use
# with any native driver. This service is the one thing in the whole stack still allowed
# to use it directly - it just happens to be reachable from wherever db-proxy itself is
# deployed (e.g. Render), even on hosts where the backend's own outbound connection to
# this port is blocked. Get this from Atlas > Database > Connect > Drivers.
MONGODB_URI=

# Shared secret between this proxy and backend/. Must be the EXACT same value as
# MONGODB_DATA_API_KEY in backend/.env - the proxy checks incoming requests' api-key
# header against this. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROXY_API_KEY=

# Port this service listens on. Defaults to 4000 in server.js if unset - only set this
# manually if 4000 is already taken locally, or if your host (e.g. Render) requires a
# specific port.
PORT=

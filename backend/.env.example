# Copy this to .env (backend/.env) and fill in real values. Never commit the real .env.

# Atlas Data API (HTTPS), not the native mongodb+srv:// driver - the driver's port
# (27017, and even 443 to the same hosts) is blocked outbound on our review host, but
# plain HTTPS to a different Atlas domain (data.mongodb-api.com) isn't. Enable the Data
# API for your cluster in the Atlas dashboard, create an API key, and fill these in.
MONGODB_DATA_API_URL=
MONGODB_DATA_API_KEY=
# usually "mongodb-atlas" unless you renamed the linked data source in Atlas
MONGODB_DATA_SOURCE=mongodb-atlas
MONGODB_DATABASE=occubuy

# Port the server listens on. On cPanel's "Setup Node.js App", this is usually injected
# for you - only set it manually for local dev if 8787 is already in use.
PORT=8787

# Server-side-only secret mixed into every partner-key/session-token hash. Without this
# set to a real random value, anyone with the Mongo dump could brute-force keys offline.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OCCUBUY_HASH_PEPPER=


# MongoDB's own Atlas Data API was shut down for good on 30 Sept 2025 - it no longer
# exists, don't go looking for it in the Atlas dashboard. Instead this points at OUR
# OWN db-proxy service (see /db-proxy), which speaks the same request shape (same
# /action/findOne etc. paths, same api-key header) but is really just Express +
# Mongoose talking to Atlas over the normal driver. It exists because the native
# mongodb+srv:// port is blocked outbound on our review host, but plain HTTPS isn't.
#
# MONGODB_DATA_API_URL = wherever db-proxy is deployed, e.g. https://<name>.onrender.com
# MONGODB_DATA_API_KEY = must exactly match db-proxy's own PROXY_API_KEY env var
MONGODB_DATA_API_URL=https://<your-db-proxy>.onrender.com
MONGODB_DATA_API_KEY=change-me

# usually "mongodb-atlas" unless you renamed the linked data source in Atlas
MONGODB_DATA_SOURCE=mongodb-atlas
MONGODB_DATABASE=occubuy

# Port the server listens on. On cPanel's "Setup Node.js App", this is usually injected
# for you - only set it manually for local dev if 8787 is already in use.
PORT=8787

# Server-side-only secret mixed into every partner-key/session-token hash. Without this
# set to a real random value, anyone with the Mongo dump could brute-force keys offline.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OCCUBUY_HASH_PEPPER=change-me

# Comma-separated list of origins allowed to call this API from a browser (CORS). If unset,
# falls back to the demo page + common localhost dev ports - see backend/src/app.ts. Add
# every real partner site's origin here once partners are actually onboarding.
ALLOWED_ORIGINS=

# Real Yodlee sandbox (own free dev account, not Occubuy's tenant). Set BANK_PROVIDER=yodlee
# plus all five vars below to mint a real FastLink session instead of the mock one; leave
# BANK_PROVIDER unset (or anything but "yodlee") to keep using the mock, which is the
# default and what CI/tests run against. See backend/src/config/yodleeAuth.ts.
BANK_PROVIDER=
# From your account's General Settings > Authentication > Client Credentials (DEVELOPMENT).
YODLEE_API_BASE_URL=https://sandbox.preprod.yodlee.com/ysl
YODLEE_CLIENT_ID=
YODLEE_SECRET=
# A sandbox TEST USER's loginName - NOT the *_ADMIN one, Yodlee's own docs warn the admin
# login doesn't authenticate correctly for this call.
YODLEE_LOGIN_NAME=
# From General Settings > API URLs > DEVELOPMENT > FastLink 4.0 URL.
YODLEE_FASTLINK_URL=
# A built-in FastLink sub-flow name (e.g. "Aggregation", "Verification") - NOT a name
# from the Configuration Tool, which is a non-persisting demo widget whose values never
# actually register server-side and get rejected with E601 INVALID_PARAMETER_OR_VALUE.
YODLEE_CONFIG_NAME=

# Where occubuy-integration-main (the partner portal) is running. Only used now to push a
# shared score back to the portal as a lead (pushLeadToPortal) - authenticatePartnerKey()
# checks a local partner copy instead of calling the portal, kept in sync via the portal's
# own outbound call to this backend's POST /api/internal/partners/sync (see
# routes/internal.routes.ts and integration-memory.md). Defaults to the portal's local dev
# port (4001).
PORTAL_BASE_URL=http://localhost:4001

# Must exactly match the portal's own OCCUBUY_INTERNAL_SECRET (occubuy-integration-main/.env).
# Gates this backend's own POST /api/internal/partners/sync (only the portal should call it)
# and the outbound POST /api/internal/leads push above, not the public internet either way.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OCCUBUY_INTERNAL_SECRET=
